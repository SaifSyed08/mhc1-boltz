diff --git a/scripts/train/train.py b/scripts/train/train.py
index 7a6491d..8541898 100644
--- a/scripts/train/train.py
+++ b/scripts/train/train.py
@@ -72,6 +72,7 @@ class TrainConfig:
     find_unused_parameters: Optional[bool] = False
     save_top_k: Optional[int] = 1
     validation_only: bool = False
+    freeze_trunk: Optional[list] = None   # LOCAL PATCH: module names to freeze
     debug: bool = False
     strict_loading: bool = True
     load_confidence_from_trunk: Optional[bool] = False
@@ -161,9 +162,39 @@ def train(raw_config: str, args: list[str]) -> None:  # noqa: C901, PLR0912, PLR
         if cfg.load_confidence_from_trunk:
             os.remove(file_path)
 
+    # LOCAL PATCH (see reports/UPSTREAM_PATCHES.md): optional trunk freezing.
+    # Boltz has no built-in way to fine-tune a subset of the model. Freezing the
+    # msa and pairformer modules (150.6M of 453.6M trainable params) removes both
+    # their gradients AND the activations autograd would otherwise retain for
+    # their backward pass, which is what makes fine-tuning fit on an 8 GB card.
+    # It is also a defensible strategy for pMHC-I, where the task is largely the
+    # geometry of a peptide in a groove rather than representation learning.
+    freeze = getattr(cfg, "freeze_trunk", None)
+    if freeze:
+        frozen = trainable = 0
+        for name, p in model_module.named_parameters():
+            if name.split(".")[0] in set(freeze):
+                p.requires_grad = False
+                frozen += p.numel()
+            elif p.requires_grad:
+                trainable += p.numel()
+        print(f"[freeze_trunk] froze {freeze}: {frozen/1e6:.1f}M frozen, "
+              f"{trainable/1e6:.1f}M trainable")
+
     # Create checkpoint callback
     callbacks = []
     dirpath = cfg.output
+    # LOCAL PATCH (see reports/UPSTREAM_PATCHES.md): trainer.validate() keeps its
+    # running metric state only in memory and emits nothing until the epoch ends,
+    # so an interrupted validation loses every completed sample. This callback
+    # snapshots the MeanMetric sufficient statistics to disk after each batch.
+    try:
+        sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "src"))
+        from val_progress import ValProgressDump
+
+        callbacks.append(ValProgressDump(Path(cfg.output) / "val_state.json"))
+    except Exception as exc:  # never let telemetry break a run
+        print(f"[val_progress] disabled: {type(exc).__name__}: {exc}")
     if not cfg.disable_checkpoint:
         mc = ModelCheckpoint(
             monitor="val/lddt",
@@ -172,7 +203,10 @@ def train(raw_config: str, args: list[str]) -> None:  # noqa: C901, PLR0912, PLR
             mode="max",
             every_n_epochs=1,
         )
-        callbacks = [mc]
+        # LOCAL PATCH: was `callbacks = [mc]`, which discards anything already
+        # registered -- including the val_progress dump added above. Appending
+        # keeps both.
+        callbacks.append(mc)
 
     # Create wandb logger
     loggers = []
